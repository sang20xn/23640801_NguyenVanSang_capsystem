openapi: 3.0.3

info:
  title: API Quản lý tài xế
  description: Đặc tả API cho FR-03 - Quản lý tài xế
  version: 1.0.0

servers:
  - url: http://localhost:8080

paths:

  /api/drivers:
    post:
      summary: FR-03.1 - Tạo tài khoản tài xế
      tags:
        - Driver Management
      security:
        - bearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            example:
              fullName: "Trần Văn B"
              email: "tranvanb@gmail.com"
              password: "Driver@123"
              phone: "0912345678"
              licenseNumber: "790123456789"
      responses:
        '201':
          description: Tạo tài khoản tài xế thành công
          content:
            application/json:
              example:
                success: true
                message: "Tạo tài khoản tài xế thành công"
                data:
                  driverId: 2001
                  fullName: "Trần Văn B"
                  email: "tranvanb@gmail.com"
                  phone: "0912345678"
                  licenseNumber: "790123456789"
                  status: ACTIVE
                  activityStatus: OFFLINE
                  availability: UNAVAILABLE
        '400':
          description: Dữ liệu không hợp lệ
        '401':
          description: Chưa đăng nhập hoặc token không hợp lệ
        '403':
          description: Không có quyền tạo tài khoản tài xế
        '409':
          description: Email, số điện thoại hoặc số giấy phép đã tồn tại

    get:
      summary: FR-03.2 - Xem danh sách tài xế
      tags:
        - Driver Management
      security:
        - bearerAuth: []
      parameters:
        - name: page
          in: query
          required: false
          schema:
            type: integer
            default: 0
          example: 0
        - name: size
          in: query
          required: false
          schema:
            type: integer
            default: 10
          example: 10
      responses:
        '200':
          description: Lấy danh sách tài xế thành công
          content:
            application/json:
              example:
                success: true
                message: "Lấy danh sách tài xế thành công"
                data:
                  content:
                    - driverId: 2001
                      fullName: "Trần Văn B"
                      email: "tranvanb@gmail.com"
                      phone: "0912345678"
                      licenseNumber: "790123456789"
                      status: ACTIVE
                      activityStatus: ONLINE
                      availability: AVAILABLE
                    - driverId: 2002
                      fullName: "Lê Văn C"
                      email: "levanc@gmail.com"
                      phone: "0923456789"
                      licenseNumber: "790987654321"
                      status: ACTIVE
                      activityStatus: OFFLINE
                      availability: UNAVAILABLE
                  page: 0
                  size: 10
                  totalElements: 2
        '401':
          description: Chưa đăng nhập hoặc token không hợp lệ
        '403':
          description: Không có quyền xem danh sách tài xế


  /api/drivers/search:
    get:
      summary: FR-03.3 - Tìm kiếm tài xế
      tags:
        - Driver Management
      security:
        - bearerAuth: []
      parameters:
        - name: keyword
          in: query
          required: true
          description: Tìm kiếm theo tên, email, số điện thoại hoặc số giấy phép
          schema:
            type: string
          example: "Trần Văn B"
      responses:
        '200':
          description: Tìm kiếm tài xế thành công
          content:
            application/json:
              example:
                success: true
                message: "Tìm kiếm tài xế thành công"
                data:
                  - driverId: 2001
                    fullName: "Trần Văn B"
                    email: "tranvanb@gmail.com"
                    phone: "0912345678"
                    licenseNumber: "790123456789"
                    status: ACTIVE
                    activityStatus: ONLINE
                    availability: AVAILABLE
        '400':
          description: Từ khóa tìm kiếm không hợp lệ
        '401':
          description: Chưa đăng nhập hoặc token không hợp lệ
        '403':
          description: Không có quyền tìm kiếm tài xế


  /api/drivers/{driverId}:
    get:
      summary: FR-03.4 - Xem hồ sơ tài xế
      tags:
        - Driver Management
      security:
        - bearerAuth: []
      parameters:
        - name: driverId
          in: path
          required: true
          schema:
            type: integer
          example: 2001
      responses:
        '200':
          description: Lấy hồ sơ tài xế thành công
          content:
            application/json:
              example:
                success: true
                message: "Lấy hồ sơ tài xế thành công"
                data:
                  driverId: 2001
                  fullName: "Trần Văn B"
                  email: "tranvanb@gmail.com"
                  phone: "0912345678"
                  address: "123 Lê Lợi, Quận 1, TP.HCM"
                  licenseNumber: "790123456789"
                  status: ACTIVE
                  activityStatus: ONLINE
                  availability: AVAILABLE
                  rating: 4.8
        '401':
          description: Chưa đăng nhập hoặc token không hợp lệ
        '403':
          description: Không có quyền xem hồ sơ tài xế
        '404':
          description: Không tìm thấy tài xế

    put:
      summary: FR-03.4 - Cập nhật hồ sơ tài xế
      tags:
        - Driver Management
      security:
        - bearerAuth: []
      parameters:
        - name: driverId
          in: path
          required: true
          schema:
            type: integer
          example: 2001
      requestBody:
        required: true
        content:
          application/json:
            example:
              fullName: "Trần Văn B"
              phone: "0912345678"
              address: "456 Điện Biên Phủ, Bình Thạnh, TP.HCM"
              licenseNumber: "790123456789"
      responses:
        '200':
          description: Cập nhật hồ sơ tài xế thành công
          content:
            application/json:
              example:
                success: true
                message: "Cập nhật hồ sơ tài xế thành công"
                data:
                  driverId: 2001
                  fullName: "Trần Văn B"
                  email: "tranvanb@gmail.com"
                  phone: "0912345678"
                  address: "456 Điện Biên Phủ, Bình Thạnh, TP.HCM"
                  licenseNumber: "790123456789"
        '400':
          description: Dữ liệu cập nhật không hợp lệ
        '401':
          description: Chưa đăng nhập hoặc token không hợp lệ
        '403':
          description: Không có quyền cập nhật hồ sơ tài xế
        '404':
          description: Không tìm thấy tài xế


  /api/drivers/{driverId}/status:
    patch:
      summary: FR-03.5 - Khóa hoặc mở khóa tài xế
      tags:
        - Driver Management
      security:
        - bearerAuth: []
      parameters:
        - name: driverId
          in: path
          required: true
          schema:
            type: integer
          example: 2001
      requestBody:
        required: true
        content:
          application/json:
            example:
              status: LOCKED
      responses:
        '200':
          description: Cập nhật trạng thái tài khoản tài xế thành công
          content:
            application/json:
              example:
                success: true
                message: "Cập nhật trạng thái tài khoản tài xế thành công"
                data:
                  driverId: 2001
                  status: LOCKED
        '400':
          description: Trạng thái không hợp lệ
        '401':
          description: Chưa đăng nhập hoặc token không hợp lệ
        '403':
          description: Không có quyền khóa hoặc mở khóa tài xế
        '404':
          description: Không tìm thấy tài xế


  /api/drivers/{driverId}/activity-status:
    patch:
      summary: FR-03.6 - Cập nhật trạng thái hoạt động
      tags:
        - Driver Management
      security:
        - bearerAuth: []
      parameters:
        - name: driverId
          in: path
          required: true
          schema:
            type: integer
          example: 2001
      requestBody:
        required: true
        content:
          application/json:
            example:
              activityStatus: ONLINE
      responses:
        '200':
          description: Cập nhật trạng thái hoạt động thành công
          content:
            application/json:
              example:
                success: true
                message: "Cập nhật trạng thái hoạt động thành công"
                data:
                  driverId: 2001
                  activityStatus: ONLINE
        '400':
          description: Trạng thái hoạt động không hợp lệ
        '401':
          description: Chưa đăng nhập hoặc token không hợp lệ
        '403':
          description: Không có quyền cập nhật trạng thái hoạt động
        '404':
          description: Không tìm thấy tài xế


  /api/drivers/{driverId}/availability:
    patch:
      summary: FR-03.7 - Cập nhật trạng thái sẵn sàng nhận chuyến
      tags:
        - Driver Management
      security:
        - bearerAuth: []
      parameters:
        - name: driverId
          in: path
          required: true
          schema:
            type: integer
          example: 2001
      requestBody:
        required: true
        content:
          application/json:
            example:
              availability: AVAILABLE
      responses:
        '200':
          description: Cập nhật trạng thái sẵn sàng nhận chuyến thành công
          content:
            application/json:
              example:
                success: true
                message: "Cập nhật trạng thái sẵn sàng nhận chuyến thành công"
                data:
                  driverId: 2001
                  availability: AVAILABLE
        '400':
          description: Trạng thái sẵn sàng không hợp lệ
        '401':
          description: Chưa đăng nhập hoặc token không hợp lệ
        '403':
          description: Không có quyền cập nhật trạng thái
        '404':
          description: Không tìm thấy tài xế


  /api/drivers/{driverId}/location:
    get:
      summary: FR-03.8 - Theo dõi vị trí tài xế
      tags:
        - Driver Tracking
      security:
        - bearerAuth: []
      parameters:
        - name: driverId
          in: path
          required: true
          schema:
            type: integer
          example: 2001
      responses:
        '200':
          description: Lấy vị trí tài xế thành công
          content:
            application/json:
              example:
                success: true
                message: "Lấy vị trí tài xế thành công"
                data:
                  driverId: 2001
                  latitude: 10.7769
                  longitude: 106.7009
                  address: "Quận 1, TP.HCM"
                  updatedAt: "2026-09-07T14:30:00"
        '401':
          description: Chưa đăng nhập hoặc token không hợp lệ
        '403':
          description: Không có quyền theo dõi vị trí tài xế
        '404':
          description: Không tìm thấy tài xế hoặc không có dữ liệu vị trí


components:

  securitySchemes:

    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
